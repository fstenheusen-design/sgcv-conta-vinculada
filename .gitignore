services:
  db:
    image: postgres:16-alpine
    container_name: sgcv_db
    environment:
      POSTGRES_DB: sgcv
      POSTGRES_USER: sgcv_user
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    ports:
      - "5432:5432"
    volumes:
      - ./pgdata:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U sgcv_user -d sgcv"]
      interval: 5s
      timeout: 5s
      retries: 5